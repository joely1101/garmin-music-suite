<Window x:Class="GarminMusicStudio.Views.PlaylistDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GarminMusicStudio.Models"
        Title="Garmin Studio - 播放清單詳細資訊" Width="560" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True">

    <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
            BorderThickness="1" CornerRadius="12" Padding="24"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 " FontSize="20" Foreground="{StaticResource BrushPrimaryOrange}"/>
                    <TextBlock x:Name="TxtPlaylistName" Text="播放清單" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <!-- Close X -->
                <Button Grid.Column="1" Content="✕" Style="{StaticResource FlatButton}" 
                        FontSize="16" Foreground="{StaticResource BrushTextMuted}" 
                        Padding="8,4" Click="BtnClose_Click"/>
            </Grid>

            <!-- Subtitle info -->
            <TextBlock x:Name="TxtInfo" Grid.Row="1" Text="共 0 首歌曲" FontSize="14" 
                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14"/>

            <!-- Track List -->
            <Border Grid.Row="2" Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsSongs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PlaylistEntry}">
                                <Border Background="#1a1a1a" BorderBrush="#222222" BorderThickness="1" CornerRadius="6" 
                                        Margin="0,0,0,6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Track Index -->
                                        <Border Grid.Column="0" Background="#262626" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index, StringFormat='{}{0:D2}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryOrange}"/>
                                        </Border>

                                        <!-- Track Title & Path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Bottom Close Button -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="關閉" Style="{StaticResource OrangeButton}" Width="100" Height="38" FontSize="15" 
                        Click="BtnClose_Click" IsDefault="True" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
