<UserControl x:Class="GarminMusicStudio.Views.WatchSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GarminMusicStudio.Models"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP PANE: PC MUSIC LIBRARY ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💻 電腦音樂庫" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#262626" CornerRadius="12" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFilteredLocalCount, StringFormat='{}{0} 首'}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Folder Filter Dropdown -->
                        <ComboBox ItemsSource="{Binding LocalFilterFolders}" SelectedItem="{Binding LocalFolderFilter}"
                                  Width="150" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="15"/>

                        <!-- Search Box -->
                        <TextBox Text="{Binding LocalSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Padding="8,4" FontSize="15"/>

                        <!-- Refresh Button -->
                        <Button Style="{StaticResource FlatButton}" Content="🔄" Padding="10,5" Margin="0,0,6,0" FontSize="15"
                                Command="{Binding RefreshLocalCommand}" ToolTip="重新掃描本地歌曲"/>

                        <!-- Open Music Directory Button -->
                        <Button Style="{StaticResource FlatButton}" Content="📂 開啟資料夾" Padding="12,5" Margin="0,0,6,0" FontSize="14"
                                Command="{Binding OpenMusicDirCommand}" ToolTip="以 Windows 檔案總管開啟音樂資料夾"/>

                        <!-- Add Folder Button -->
                        <Button Style="{StaticResource FlatButton}" Content="➕ 新增目錄" Padding="12,5" FontSize="14"
                                Command="{Binding AddFolderCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Select-all and Batch Operation Bar -->
                <Border Grid.Row="1" Background="#111111" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelectAllLocal}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedLocalCount, StringFormat='{}全選 ({0}/'}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFilteredLocalCount, StringFormat='{}{0})'}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Batch Buttons (When items selected) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OrangeButton}" Padding="12,4" FontSize="14" Margin="0,0,8,0"
                                    Command="{Binding SyncSelectedCommand}"
                                    Visibility="{Binding HasSelectedLocal, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➔ 複製到手錶 (" FontSize="14"/>
                                    <TextBlock Text="{Binding SelectedLocalCount}" FontSize="14"/>
                                    <TextBlock Text=")" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Padding="10,4" FontSize="14" Foreground="{StaticResource BrushDanger}"
                                    Command="{Binding DeleteSelectedLocalCommand}"
                                    Visibility="{Binding HasSelectedLocal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedLocalDeleteText}" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Collapsible Tree View of Folders & Songs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LocalFolderGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LocalFolderGroup}">
                                <Border Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Folder Row Header -->
                                        <Border Background="#1a1a1a" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                                CornerRadius="6" Padding="10,8" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Toggle Arrow -->
                                                <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                                                        Padding="4,0" Margin="0,0,8,0" FontSize="13" Content="{Binding ExpandIcon}"/>

                                                <!-- Select Folder Checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Folder Icon & Name -->
                                                <TextBlock Grid.Column="2" Text="📁 " FontSize="16" Foreground="#f59e0b" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" [" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                                                    <Run Text="{Binding TrackCount, Mode=OneWay}" Foreground="{StaticResource BrushPrimaryOrange}" FontSize="14"/>
                                                    <Run Text="]" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                                                </TextBlock>

                                                <!-- Delete Folder Button (Only for custom folders, not default 音樂/podcast) -->
                                                <Button Grid.Column="4" Style="{StaticResource FlatButton}"
                                                        Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                        Padding="6,2" Margin="0,0,10,0" FontSize="12" Foreground="{StaticResource BrushDanger}"
                                                        ToolTip="刪除此目錄">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗑 刪除目錄" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Hint -->
                                                <TextBlock Grid.Column="5" Text="{Binding ExpandTooltip}" FontSize="13" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Songs Inside Folder (Collapsed when IsExpanded = false) -->
                                        <Border BorderBrush="#262626" BorderThickness="1,0,0,0" Margin="16,3,0,6" Padding="10,3,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tracks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:Track}">
                                                        <Border Background="#121212" BorderBrush="#1f1f1f" BorderThickness="1"
                                                                CornerRadius="5" Margin="0,0,0,4" Padding="10,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Checkbox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                <!-- Music note icon -->
                                                                <TextBlock Grid.Column="1" Text="🎵" FontSize="15" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                <!-- Play / Preview Button -->
                                                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6,3" Margin="0,0,10,0"
                                                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" ToolTip="試聽歌曲">
                                                                    <TextBlock Text="▶" FontSize="12" Foreground="{StaticResource BrushPrimaryOrange}"/>
                                                                </Button>

                                                                <!-- Title and Artist -->
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist, StringFormat='{} - {0}'}" FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Status Badge (手錶已存 / 未同步) -->
                                                                <Border Grid.Column="4" CornerRadius="4" Padding="8,3" Margin="10,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#171717"/>
                                                                            <Setter Property="BorderBrush" Value="#262626"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSyncedOnWatch}" Value="True">
                                                                                    <Setter Property="Background" Value="#064e3b"/>
                                                                                    <Setter Property="BorderBrush" Value="#059669"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="13">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="未同步"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSyncedOnWatch}" Value="True">
                                                                                        <Setter Property="Text" Value="手錶已存"/>
                                                                                        <Setter Property="Foreground" Value="#34d399"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>

                                                                <!-- File Size -->
                                                                <TextBlock Grid.Column="5" Text="{Binding SizeFormatted}" FontSize="14" Foreground="{StaticResource BrushTextMuted}" 
                                                                           VerticalAlignment="Center" Margin="0,0,12,0" Width="75" TextAlignment="Right"/>

                                                                <!-- Actions: ✎ 改名 | ➔ 複製 | 🗑 刪除 -->
                                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource FlatButton}" Content="✎ 改名" Padding="8,3" FontSize="13" Margin="0,0,5,0"
                                                                            Command="{Binding DataContext.RenameTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource FlatButton}" Content="➔ 複製" Padding="8,3" FontSize="13" Margin="0,0,5,0"
                                                                            Command="{Binding DataContext.CopySingleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="單曲複製到手錶"/>
                                                                    <Button Style="{StaticResource FlatButton}" Content="🗑 刪除" Padding="8,3" FontSize="13" Foreground="{StaticResource BrushDanger}"
                                                                            Command="{Binding DataContext.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Divider Space -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Center"/>

        <!-- ==================== BOTTOM PANE: GARMIN WATCH MUSIC LIBRARY ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Watch Header Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⌚ Garmin 手錶音樂庫" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#262626" CornerRadius="12" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFilteredWatchCount, StringFormat='{}{0} 首'}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Folder Filter Dropdown -->
                        <ComboBox ItemsSource="{Binding WatchFilterFolders}" SelectedItem="{Binding WatchFolderFilter}"
                                  Width="150" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="15"/>

                        <!-- Search Box -->
                        <TextBox Text="{Binding WatchSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="180" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Padding="8,4" FontSize="15"/>

                        <!-- Refresh Button -->
                        <Button Style="{StaticResource FlatButton}" Content="🔄" Padding="10,5" FontSize="15" Margin="0,0,8,0"
                                Command="{Binding RefreshWatchCommand}" ToolTip="重新整理手錶清單"/>

                        <!-- Diagnostic Log Button -->
                        <Button Style="{StaticResource FlatButton}" Content="📄 診斷紀錄" Padding="10,5" FontSize="14"
                                Command="{Binding OpenMtpLogCommand}" ToolTip="開啟手錶連線與 MTP 掃描診斷日誌 (Log)"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Select-all and Batch Operation Bar -->
                <Border Grid.Row="1" Background="#111111" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelectAllWatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedWatchCount, StringFormat='{}全選 ({0}/'}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFilteredWatchCount, StringFormat='{}{0})'}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                            <TextBlock Text="  |  手錶播放清單 (.m3u8) 支援" FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Batch Remove Button -->
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="10,4" FontSize="14" Foreground="{StaticResource BrushDanger}"
                                Command="{Binding DeleteSelectedWatchCommand}"
                                Visibility="{Binding HasSelectedWatch, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑 從手錶移除 (" FontSize="14"/>
                                <TextBlock Text="{Binding SelectedWatchCount}" FontSize="14"/>
                                <TextBlock Text=")" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Collapsible Tree View of Watch Folders & Songs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding WatchFolderGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WatchFolderGroup}">
                                <Border Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Folder Row Header -->
                                        <Border Background="#1a1a1a" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                                CornerRadius="6" Padding="10,8" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Toggle Arrow -->
                                                <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                                                        Padding="4,0" Margin="0,0,8,0" FontSize="13" Content="{Binding ExpandIcon}"/>

                                                <!-- Select Folder Checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Folder Icon & Name -->
                                                <TextBlock Grid.Column="2" Text="📁 " FontSize="16" Foreground="#f59e0b" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" [" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                                                    <Run Text="{Binding TrackCount, Mode=OneWay}" Foreground="{StaticResource BrushPrimaryOrange}" FontSize="14"/>
                                                    <Run Text="]" Foreground="{StaticResource BrushTextMuted}" FontSize="14"/>
                                                </TextBlock>

                                                <!-- Hint -->
                                                <TextBlock Grid.Column="4" Text="{Binding ExpandTooltip}" FontSize="13" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Songs Inside Folder -->
                                        <Border BorderBrush="#262626" BorderThickness="1,0,0,0" Margin="16,3,0,6" Padding="10,3,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tracks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:WatchTrack}">
                                                        <Border Background="#121212" BorderBrush="#1f1f1f" BorderThickness="1"
                                                                CornerRadius="5" Margin="0,0,0,4" Padding="10,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayIcon}" FontSize="15" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist, StringFormat='{} - {0}'}" FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontSize="14" Foreground="{StaticResource BrushTextMuted}" 
                                                                           VerticalAlignment="Center" Margin="0,0,12,0" Width="75" TextAlignment="Right"/>

                                                                <!-- Details Button for Playlist -->
                                                                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Padding="8,3" FontSize="13" Margin="0,0,8,0"
                                                                        Foreground="{StaticResource BrushPrimaryOrange}"
                                                                        Command="{Binding DataContext.ShowPlaylistDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="查看播放清單內的歌曲清單">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="ℹ " FontSize="12"/>
                                                                        <TextBlock Text="詳細資訊" FontSize="13"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <Button Grid.Column="5" Style="{StaticResource FlatButton}" Content="🗑 從手錶移除" Padding="8,3" FontSize="13" Foreground="{StaticResource BrushDanger}"
                                                                        Command="{Binding DataContext.DeleteWatchTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state if 0 watch songs -->
                <Border Grid.Row="2" Background="#141414" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" 
                        Padding="28" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalFilteredWatchCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="⌚ 手錶尚未偵測到歌曲或目錄為空" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                   FontSize="16" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Text="若手錶內已有音樂但此處顯示 0 首，請點擊下方「查看診斷紀錄」檢視排查資訊，或至「設定」檢查手錶 MTP 選取狀態。" 
                                   FontSize="13" Foreground="#737373" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource FlatButton}" Content="📄 查看診斷紀錄 (Log)" 
                                HorizontalAlignment="Center" Padding="16,6" FontSize="14"
                                Command="{Binding OpenMtpLogCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== BOTTOM SYNC ACTION BAR ==================== -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status text -->
                <TextBlock Grid.Column="0" Text="{Binding SyncStatusText}" Foreground="{StaticResource BrushPrimaryOrange}" 
                           FontSize="16" VerticalAlignment="Center" FontWeight="Medium"/>

                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="建立播放清單" Margin="0,0,12,0" Padding="16,8" FontSize="16"
                        Command="{Binding CreatePlaylistCommand}"/>

                <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="一鍵同步勾選歌曲至手錶" Padding="22,8" FontSize="16"
                        Command="{Binding SyncSelectedCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
