<UserControl x:Class="GarminMusicStudio.Views.WatchSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GarminMusicStudio.Models"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP PANE: PC MUSIC LIBRARY ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💻 電腦音樂庫" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#262626" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFilteredLocalCount, StringFormat='{}{0} 首'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Folder Filter Dropdown -->
                        <ComboBox ItemsSource="{Binding LocalFilterFolders}" SelectedItem="{Binding LocalFolderFilter}"
                                  Width="130" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"/>

                        <!-- Search Box -->
                        <TextBox Text="{Binding LocalSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="160" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Padding="8,4" FontSize="12"/>

                        <!-- Refresh Button -->
                        <Button Style="{StaticResource FlatButton}" Content="🔄" Padding="8,4" Margin="0,0,6,0"
                                Command="{Binding RefreshLocalCommand}" ToolTip="重新掃描本地歌曲"/>

                        <!-- Add Folder Button -->
                        <Button Style="{StaticResource FlatButton}" Content="➕ 新增目錄" Padding="10,4" FontSize="11"
                                Command="{Binding AddFolderCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Select-all and Batch Operation Bar -->
                <Border Grid.Row="1" Background="#111111" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelectAllLocal}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedLocalCount, StringFormat='{}全選 ({0}/'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFilteredLocalCount, StringFormat='{}{0})'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Batch Buttons (When items selected) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OrangeButton}" Padding="10,3" FontSize="11" Margin="0,0,8,0"
                                    Command="{Binding SyncSelectedCommand}"
                                    Visibility="{Binding HasSelectedLocal, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➔ 複製到手錶 (" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedLocalCount}" FontSize="11"/>
                                    <TextBlock Text=")" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Padding="8,3" FontSize="11" Foreground="{StaticResource BrushDanger}"
                                    Command="{Binding DeleteSelectedLocalCommand}"
                                    Visibility="{Binding HasSelectedLocal, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑 刪除 (" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedLocalCount}" FontSize="11"/>
                                    <TextBlock Text=")" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Collapsible Tree View of Folders & Songs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LocalFolderGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LocalFolderGroup}">
                                <Border Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- Folder Row Header -->
                                        <Border Background="#1a1a1a" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                                CornerRadius="5" Padding="8,6" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Toggle Arrow -->
                                                <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                                                        Padding="4,0" Margin="0,0,6,0" FontSize="10" Content="{Binding ExpandIcon}"/>

                                                <!-- Select Folder Checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Folder Icon & Name -->
                                                <TextBlock Grid.Column="2" Text="📁 " FontSize="12" Foreground="#f59e0b" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" [" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                    <Run Text="{Binding TrackCount, Mode=OneWay}" Foreground="{StaticResource BrushPrimaryOrange}" FontSize="11"/>
                                                    <Run Text="]" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                </TextBlock>

                                                <!-- Hint -->
                                                <TextBlock Grid.Column="4" Text="{Binding ExpandTooltip}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Songs Inside Folder (Collapsed when IsExpanded = false) -->
                                        <Border BorderBrush="#262626" BorderThickness="1,0,0,0" Margin="14,2,0,4" Padding="8,2,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tracks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:Track}">
                                                        <Border Background="#121212" BorderBrush="#1f1f1f" BorderThickness="1"
                                                                CornerRadius="4" Margin="0,0,0,3" Padding="8,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Checkbox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                                <!-- Music note icon -->
                                                                <TextBlock Grid.Column="1" Text="🎵" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                                <!-- Play / Preview Button -->
                                                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="5,2" Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" ToolTip="試聽歌曲">
                                                                    <TextBlock Text="▶" FontSize="9" Foreground="{StaticResource BrushPrimaryOrange}"/>
                                                                </Button>

                                                                <!-- Title and Artist -->
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist, StringFormat='{} - {0}'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Status Badge (手錶已存 / 未同步) -->
                                                                <Border Grid.Column="4" CornerRadius="4" Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#171717"/>
                                                                            <Setter Property="BorderBrush" Value="#262626"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSyncedOnWatch}" Value="True">
                                                                                    <Setter Property="Background" Value="#064e3b"/>
                                                                                    <Setter Property="BorderBrush" Value="#059669"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="未同步"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSyncedOnWatch}" Value="True">
                                                                                        <Setter Property="Text" Value="手錶已存"/>
                                                                                        <Setter Property="Foreground" Value="#34d399"/>
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>

                                                                <!-- File Size -->
                                                                <TextBlock Grid.Column="5" Text="{Binding SizeFormatted}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                                                           VerticalAlignment="Center" Margin="0,0,10,0" Width="60" TextAlignment="Right"/>

                                                                <!-- Actions: ✎ 改名 | ➔ 複製 | 🗑 刪除 -->
                                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource FlatButton}" Content="✎ 改名" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                                                            Command="{Binding DataContext.RenameTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource FlatButton}" Content="➔ 複製" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                                                            Command="{Binding DataContext.CopySingleTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" ToolTip="單曲複製到手錶"/>
                                                                    <Button Style="{StaticResource FlatButton}" Content="🗑 刪除" Padding="6,2" FontSize="10" Foreground="{StaticResource BrushDanger}"
                                                                            Command="{Binding DataContext.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Divider Space -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Center"/>

        <!-- ==================== BOTTOM PANE: GARMIN WATCH MUSIC LIBRARY ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Watch Header Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⌚ Garmin 手錶音樂庫" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#262626" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalFilteredWatchCount, StringFormat='{}{0} 首'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Folder Filter Dropdown -->
                        <ComboBox ItemsSource="{Binding WatchFilterFolders}" SelectedItem="{Binding WatchFolderFilter}"
                                  Width="130" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"/>

                        <!-- Search Box -->
                        <TextBox Text="{Binding WatchSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="160" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Padding="8,4" FontSize="12"/>

                        <!-- Refresh Button -->
                        <Button Style="{StaticResource FlatButton}" Content="🔄" Padding="8,4"
                                Command="{Binding RefreshWatchCommand}" ToolTip="重新整理手錶清單"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Select-all and Batch Operation Bar -->
                <Border Grid.Row="1" Background="#111111" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsSelectAllWatch}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedWatchCount, StringFormat='{}全選 ({0}/'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFilteredWatchCount, StringFormat='{}{0})'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                            <TextBlock Text="  |  手錶播放清單 (.m3u8) 支援" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Batch Remove Button -->
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="8,3" FontSize="11" Foreground="{StaticResource BrushDanger}"
                                Command="{Binding DeleteSelectedWatchCommand}"
                                Visibility="{Binding HasSelectedWatch, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑 從手錶移除 (" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedWatchCount}" FontSize="11"/>
                                <TextBlock Text=")" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Collapsible Tree View of Watch Folders & Songs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding WatchFolderGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WatchFolderGroup}">
                                <Border Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- Folder Row Header -->
                                        <Border Background="#1a1a1a" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                                CornerRadius="5" Padding="8,6" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Toggle Arrow -->
                                                <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}"
                                                        Padding="4,0" Margin="0,0,6,0" FontSize="10" Content="{Binding ExpandIcon}"/>

                                                <!-- Select Folder Checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Folder Icon & Name -->
                                                <TextBlock Grid.Column="2" Text="📁 " FontSize="12" Foreground="#f59e0b" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" [" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                    <Run Text="{Binding TrackCount, Mode=OneWay}" Foreground="{StaticResource BrushPrimaryOrange}" FontSize="11"/>
                                                    <Run Text="]" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
                                                </TextBlock>

                                                <!-- Hint -->
                                                <TextBlock Grid.Column="4" Text="{Binding ExpandTooltip}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Songs Inside Folder -->
                                        <Border BorderBrush="#262626" BorderThickness="1,0,0,0" Margin="14,2,0,4" Padding="8,2,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Tracks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:WatchTrack}">
                                                        <Border Background="#121212" BorderBrush="#1f1f1f" BorderThickness="1"
                                                                CornerRadius="4" Margin="0,0,0,3" Padding="8,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Grid.Column="1" Text="🎵" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist, StringFormat='{} - {0}'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                                                           VerticalAlignment="Center" Margin="0,0,10,0" Width="60" TextAlignment="Right"/>

                                                                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Content="🗑 從手錶移除" Padding="6,2" FontSize="10" Foreground="{StaticResource BrushDanger}"
                                                                        Command="{Binding DataContext.DeleteWatchTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== BOTTOM SYNC ACTION BAR ==================== -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status text -->
                <TextBlock Grid.Column="0" Text="{Binding SyncStatusText}" Foreground="{StaticResource BrushPrimaryOrange}" 
                           FontSize="12" VerticalAlignment="Center" FontWeight="Medium"/>

                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="建立播放清單" Margin="0,0,10,0" Padding="14,7"
                        Command="{Binding CreatePlaylistCommand}"/>

                <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="一鍵同步勾選歌曲至手錶" Padding="18,7"
                        Command="{Binding SyncSelectedCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
