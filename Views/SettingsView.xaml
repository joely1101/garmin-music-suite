<UserControl x:Class="GarminMusicStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

            <!-- SECTION 1: WATCH DIRECTORY SETTINGS -->
            <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="手錶路徑與自訂設定" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="預設自動偵測 Garmin 磁碟代號 (如 D:\) 或 MTP 手錶裝置。若為網路分享路徑或非標準掛載，可手動指定路徑。" 
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding CustomWatchPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" 
                                 VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <Button Grid.Column="1" Style="{StaticResource OrangeButton}" Content="瀏覽選取..." 
                                Command="{Binding BrowseWatchPathCommand}" Margin="0,0,8,0" Height="36" Padding="14,0"/>

                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="恢復自動偵測" 
                                Command="{Binding ClearWatchPathCommand}" Height="36" Padding="14,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: SUBSONIC GARMIN SERVER (WIFI SYNC) -->
            <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Garmin Subsonic 無線伺服器 (WiFi 同步)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                                Command="{Binding ToggleServerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Content" Value="啟動伺服器"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Content" Value="停止伺服器"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Text="相容 Garmin 手錶 SubMusic App 等 Subsonic 客戶端，讓手錶透過 WiFi 直接串流與離線下載音樂。" 
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Server Status -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="服務運行狀態" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="已停止"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Text" Value="運行中 (Listening)"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Local IP & Port -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="本機連線位址" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubsonicUrl}" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushPrimaryOrange}" Margin="0,0,0,10"/>

                        <!-- Watch Config Instructions -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="手錶設定教學" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="在手錶 SubMusic App 中新增伺服器，網址填入上述本機位址，使用者名稱填 admin，密碼填 admin 即可完成連線同步。" 
                                   FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
