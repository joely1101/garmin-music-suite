<UserControl x:Class="GarminMusicStudio.Views.YouTubeDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP CARD: DOWNLOAD FORM -->
        <Border Grid.Row="0" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="下載 YouTube 音訊至電腦" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="自動轉碼為 Garmin 手錶專用規格（192kbps、44.1kHz Stereo、ID3v2.3 標籤），保證手錶硬體即時播放。" 
                           FontSize="15" Foreground="{StaticResource BrushTextSecondary}" Margin="0,5,0,22"/>

                <!-- URL Input -->
                <TextBlock Text="YouTube 影片或音樂網址" FontSize="15" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,18" 
                         VerticalContentAlignment="Center" FontSize="16"/>

                <!-- Options & Submit -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Folder -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="儲存目錄分類" FontSize="15" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="42" ItemsSource="{Binding Folders}" SelectedItem="{Binding TargetFolder}" 
                                      Background="#0a0a0a" Foreground="{StaticResource BrushTextPrimary}"
                                      BorderBrush="{StaticResource BrushCardBorder}" FontSize="16" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="+" ToolTip="新增下載目錄"
                                    Command="{Binding AddFolderCommand}" Height="42" Width="38" Margin="6,0,0,0" Padding="0"
                                    FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Playlist Checkbox -->
                    <CheckBox Grid.Column="1" Content="若為播放清單或整張專輯，下載全部歌曲" 
                              IsChecked="{Binding DownloadPlaylist}" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="15"/>

                    <!-- Download Button -->
                    <Button Grid.Column="2" Style="{StaticResource OrangeButton}" Content="開始下載與轉碼" 
                            Command="{Binding StartDownloadCommand}" VerticalAlignment="Bottom" Height="44" Padding="24,0" FontSize="16"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BOTTOM CARD: TASK QUEUE -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
                BorderThickness="1" CornerRadius="8" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="下載任務狀態" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="🗑 一鍵清空" 
                            Command="{Binding ClearTasksCommand}" Padding="14,6" FontSize="14" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121212" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                        CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title, Folder & Progress -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                <TextBlock Text="{Binding TargetFolder, StringFormat='{}  [{0}]'}" FontSize="14" Foreground="{StaticResource BrushPrimaryOrange}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Progress}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- Status Badge & Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="12,5" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#332b14"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                <Setter Property="Background" Value="#064e3b"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                <Setter Property="Background" Value="#450a0a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                <Setter Property="Background" Value="#262626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="14" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#eab308"/>
                                                            <Setter Property="Text" Value="下載中..."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                    <Setter Property="Foreground" Value="#34d399"/>
                                                                    <Setter Property="Text" Value="已完成"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                    <Setter Property="Foreground" Value="#f87171"/>
                                                                    <Setter Property="Text" Value="失敗"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                                    <Setter Property="Foreground" Value="#9ca3af"/>
                                                                    <Setter Property="Text" Value="已取消"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Cancel Button -->
                                            <Button Style="{StaticResource FlatButton}" Content="取消" Margin="0,0,8,0" Padding="12,5" FontSize="13"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Delete Button -->
                                            <Button Style="{StaticResource FlatButton}" Content="刪除" Padding="12,5" FontSize="13"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
