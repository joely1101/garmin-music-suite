<Window x:Class="GarminMusicStudio.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garmin Studio" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True">
    
    <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" 
            BorderThickness="1" CornerRadius="12" Padding="26"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitle" Text="輸入" FontSize="20" FontWeight="SemiBold" 
                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14"/>

            <TextBlock x:Name="TxtPrompt" Grid.Row="1" Text="請輸入內容:" FontSize="15" 
                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14"
                       TextWrapping="Wrap" LineHeight="22"/>

            <TextBox x:Name="TxtInput" Grid.Row="2" Height="44" FontSize="16" Padding="12,8"
                     VerticalContentAlignment="Center" Margin="0,0,0,22"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FlatButton}" Width="95" Height="40" FontSize="15" Margin="0,0,12,0" 
                        Click="BtnCancel_Click" IsCancel="True"/>
                <Button Content="確定" Style="{StaticResource OrangeButton}" Width="95" Height="40" FontSize="15" 
                        Click="BtnOk_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
